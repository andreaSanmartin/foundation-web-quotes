# Copiar como .env (en la raiz del repositorio, junto a docker-compose.yml).
# Estas variables las usa docker compose. Las del correo y el administrador
# inicial van en nombre-fundacion-backend/.env

# Tu usuario de Docker Hub y la version de las imagenes
DOCKERHUB_USER=tu-usuario
TAG=1.0.0

# Puertos publicados en la maquina
FRONTEND_PORT=8080
BACKEND_PORT=3000

# URL publica del backend (la que usa el navegador)
API_URL=http://localhost:3000
# URL publica del frontend (permitida por CORS)
CORS_ALLOWED_ORIGINS=http://localhost:8080

NOMBRE_FUNDACION=Nombre Fundación

# Dejar comentado para usar el MongoDB del docker-compose.
# Descomentar para usar MongoDB Atlas u otro servidor.
# MONGODB_URI=mongodb+srv://<usuario>:<contrasenia>@<cluster>.mongodb.net/<base>?retryWrites=true
