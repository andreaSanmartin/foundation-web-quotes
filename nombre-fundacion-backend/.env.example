# Copiar este archivo como .env (en esta misma carpeta) y completar los valores.
# El archivo .env NO se sube al repositorio.

PORT=3000

# Cadena de conexion de MongoDB (local o Atlas)
# Ejemplo Atlas: mongodb+srv://<usuario>:<contrasenia>@<cluster>.mongodb.net/<base>?retryWrites=true
MONGODB_URI=mongodb://localhost:27017/nombre_fundacion

# Origenes del frontend permitidos por CORS, separados por coma
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Correo saliente (para Gmail usar una "contrasenia de aplicacion")
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

MAX_FILE_SIZE=20MB
MAX_REQUEST_SIZE=20MB

# Usuario SuperAdministrador inicial: se crea al arrancar solo si la base no tiene usuarios.
# Despues del primer inicio se puede cambiar la contrasenia desde "Mi Perfil".
ADMIN_CEDULA=
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador
